{
    "branches": [
        "main"
    ],
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        "semantic-release-dart",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "printf \"// Updated by semantic-release on every release (see .releaserc).\\nconst packageVersion = '%s';\\n\" ${nextRelease.version} > lib/src/version.dart && sed -i \"s/^  cli-version: .*/  cli-version: \\\"${nextRelease.version}\\\"/\" skills/devmy/SKILL.md"
            }
        ],
        "@semantic-release/github",
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "CHANGELOG.md"
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "CHANGELOG.md",
                    "pubspec.yaml",
                    "lib/src/version.dart",
                    "skills/devmy/SKILL.md"
                ],
                "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
            }
        ]
    ]
}
